# Assistants — each key present adds one assistant to the UI. LLM_PROVIDER=mock runs with no key.
MISTRAL_API_KEY=                          # or legacy: OPENAI_API_KEY + OPENAI_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=ministral-8b-latest
MISTRAL_PRICE_IN=0.15                     # $ per million tokens — mistral.ai/pricing/api, read 09/09/2026
MISTRAL_PRICE_OUT=0.15
OPENAI_REAL_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_PRICE_IN=0.20                      # developers.openai.com/api/docs/pricing, read 09/09/2026:
                                          # 0.20/1.20 short context, 0.40/1.80 long context, batch at half price
OPENAI_PRICE_OUT=1.20
JUDGE=OpenAI                              # the single judge used for every assistant (falls back to the first assistant)
MAX_CALLS=600                             # plafond d'appels par instance (remis à zéro au redémarrage)
MAX_RUN_CALLS=200                         # plafond d'appels pour UN run
MAX_SESSION_COST=2                        # $ cumulés avant blocage de l'instance
MAX_FACTS_CHARS=4000                      # la fiche de faits part dans CHAQUE appel au juge
MAX_FIELD_CHARS=200
HTTP_TIMEOUT=90
WORKERS=4
DEMO_ACCOUNTS=                            # one login per reviewer: "name:password,name2:password2"
RUNS_PER_USER=5                           # static run quota per login, shown on screen
DEMO_USER=                                # fallback single account if DEMO_ACCOUNTS is empty
DEMO_PASSWORD=
